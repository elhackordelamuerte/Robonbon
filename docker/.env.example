# Copy to docker/.env and edit: cp .env.example .env

# ROS 2 domain (0-101). Use a distinct value per group sharing a machine/network.
ROS_DOMAIN_ID=42

# Set to true for simulation, false for real hardware
USE_SIM=true

# -- USE_SIM=false --

# Host serial port of the arm. Find it by plugging/unplugging the arm while running:
#   sudo udevadm monitor --subsystem-match=tty --property | grep --line-buffered -E "(DEVNAME=|ACTION=)"
REAL_ROBOT_PORT=/dev/ttyACM0

# Path to the calibration file (generated by lerobot-calibrate).
# Mounted read-only in the control container at /calibration/arm.json
CALIBRATION_FILE=~/.cache/huggingface/lerobot/calibration/robots/so_follower/my_awesome_follower_arm.json

# -- Perception échiquier (conteneur perception, YOLO) --
# Mettre COMPOSE_PROFILES=perception pour lancer chess_perception avec ./run.sh
COMPOSE_PROFILES=
# Caméra (/dev/videoN) ou photo de test (/images/image2.jpg)
PERCEPTION_SOURCE=/dev/video0
YOLO_WEIGHTS=/runs/detect/train-17/weights/best.pt
YOLO_CONF=0.25
# sans marqueur : true si a1 est au mauvais coin (avec le marqueur, a1 = coin foncé le plus proche du bras)
PERCEPTION_FLIP=false

# -- Position du plateau d'échecs par rapport au bras --
# Automatique avec le marqueur ArUco (docs/WORLD_MODEL.md) : scotché sur la table, à quelques cm
# de la feuille, visible par la caméra. Position de son CENTRE dans le repère du bras (m) :
# mesurer depuis l'axe du moteur de la base, puis ajouter 0.039 à X.
MARKER_X=0.10
MARKER_Y=0.0
# direction du haut du marqueur (flèche de la feuille) : 0 = vers l'avant du bras, 90 = vers sa gauche
MARKER_YAW=0
MARKER_SIZE=0.08
# Sans marqueur visible : coin extérieur de a1 dans le repère du bras (m, °)
BOARD_X=0.10
BOARD_Y=0.10
BOARD_YAW=-90
