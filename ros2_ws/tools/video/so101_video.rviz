Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 0.05000000074505806
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0.15
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 14
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
        gripper_frame_link:
          Alpha: 1
          Show Axes: false
          Show Trail: true
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    # Arbre des TF : monde, base du robot, pince (cinématique directe) et caméra (calibration)
    - Class: rviz_default_plugins/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): "^(world|base_link|gripper_frame_link|external_cam)$"
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_link:
          Value: true
        external_cam:
          Value: true
        gripper_frame_link:
          Value: true
        world:
          Value: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: true
    # Cube rouge = position du cube publiée par la perception (aides_rviz.py -> /video/cube)
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Cube vu par la camera
      Namespaces:
        cube: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /video/cube
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Drop box
      Namespaces:
        drop_box: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /drop_box_marker
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 40; 46
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point:
        X: 0.2
        Y: 0.08
        Z: 0.15
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.0
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.45
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: -1.25
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Views:
    collapsed: true
  Height: 1200
  Hide Left Dock: true
  Hide Right Dock: true
  Width: 2400
  X: 0
  Y: 0
